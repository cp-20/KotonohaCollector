@@ -2259,2 +2259,22 @@ TEST_F(KeyEventHandlerTest, Issue3109571ShiftHenkanShouldBeValid) {
-TEST_F(KeyEventHandlerTest, Issue3109571ShiftMuhenkanShouldBeValid) {
+#ifdef KOTONOHA_COLLECTOR_BUILD
+TEST_F(KeyEventHandlerTest, UnmodifiedImeConvertTogglesInputMode) {
+  KeyboardMock keyboard(false);
+  KeyboardStatus keyboard_status;
+  keyboard_status.SetState(VK_CONVERT, kPressed);
+
+  InputBehavior behavior = {};
+  InputState ime_state = {};
+  ime_state.open = true;
+
+  commands::KeyEvent key;
+  EXPECT_TRUE(TestableKeyEventHandler::ConvertToKeyEvent(
+      VirtualKey::FromVirtualKey(VK_CONVERT), 0, true, false, behavior,
+      ime_state, keyboard_status, &keyboard, &key));
+  EXPECT_TRUE(key.has_special_key());
+  EXPECT_EQ(key.special_key(), commands::KeyEvent::HANKAKU);
+  EXPECT_EQ(key.modifier_keys_size(), 0);
+}
+#endif  // KOTONOHA_COLLECTOR_BUILD
+
+TEST_F(KeyEventHandlerTest, Issue3109571ShiftMuhenkanShouldBeValid) {
   constexpr bool kKanaLocked = false;
