@@ -435,2 +435,16 @@ bool ConvertToKeyEventMain(const VirtualKey& virtual_key, BYTE scan_code,
-  const KeyEvent::SpecialKey special_key =
+#ifdef KOTONOHA_COLLECTOR_BUILD
+  // PowerToys calls VK_CONVERT "IME Convert".  Treat an unmodified press as
+  // the Japanese/half-width alphanumeric toggle while preserving modified
+  // Henkan shortcuts such as Shift+Henkan.
+  if (virtual_key.virtual_key() == VK_CONVERT &&
+      !keyboard_status.IsPressed(VK_SHIFT) &&
+      !keyboard_status.IsPressed(VK_CONTROL) &&
+      !keyboard_status.IsPressed(VK_MENU)) {
+    key->set_special_key(KeyEvent::HANKAKU);
+    modifer_keys->clear();
+    return true;
+  }
+#endif  // KOTONOHA_COLLECTOR_BUILD
+
+  const KeyEvent::SpecialKey special_key =
       kSpecialKeyMap[virtual_key.virtual_key()];
diff --git a/src/win32/base/keyevent_handler_test.cc b/src/win32/base/keyevent_handler_test.cc
